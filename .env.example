# ─── CONFIGURACIÓN DEL FRONTEND (Vite) ──────────────────────────────────────────
# URL de la base de datos Supabase
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Clave de Supabase secret para bypasses Row Level Security. Necesario apra carga de logo.
SUPABASE_SERVICE_ROLE_KEY=service_role

# URL pública de tu túnel de Cloudflare (o localhost para desarrollo local)
# En desarrollo local: http://localhost:3001
# En producción: https://wa-api.yourdomain.com
VITE_WA_SERVER_URL=http://localhost:3001

# Clave secreta opcional para proteger tu túnel y autorizar peticiones desde el frontend
VITE_WA_API_KEY=your_frontend_wa_api_key

# ─── CONFIGURACIÓN DEL BACKEND (Express / Baileys / Resend) ──────────────────────
# Puerto en el que corre el servidor backend en tu máquina local
WA_SERVER_PORT=3001

# Clave API que usará el servidor para validar que las peticiones vengan de tu frontend
WA_API_KEY=your_backend_wa_api_key

# API Key de Mercado Pago
MP_ACCESS_TOKEN=your_mercadopago_api_key

# Orígenes CORS permitidos. Usa '*' para desarrollo o pon la URL de tu frontend de Vercel
# Ejemplo: ALLOWED_ORIGINS=http://localhost:5173,https://web-tdm-delbono.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# API Key de Resend brindada para el envío de correos
RESEND_API_KEY=your_resend_api_key

# Remitente de los correos electrónicos (debe coincidir con tu dominio configurado en Resend)
EMAIL_FROM=Tienda de Mascotas Del Bono <turnos@noreply.264devlab.com.ar>
